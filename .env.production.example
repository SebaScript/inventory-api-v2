# ---------------------------------------------------------------------------
# PRODUCTION environment  —  docker compose -f docker-compose.prod.yml up --build
#
# Copy to `.env.production` and replace every CHANGE_ME value with a real
# secret:  cp .env.production.example .env.production
#
# This environment shares NOTHING with Test: different port, different
# PostgreSQL container, different volume, different credentials, different
# lifecycle. Never reuse the Test password here.
# ---------------------------------------------------------------------------

NODE_ENV=production
PORT=3000

# Exposed on the host at http://localhost:3200 (see docker-compose.prod.yml).
DATABASE_URL=postgres://inventory_prod:CHANGE_ME_STRONG_PRODUCTION_PASSWORD@postgres-prod:5432/inventory_prod

# Enable when the database is reached over a network you do not control.
DB_SSL=false
DB_LOGGING=false
DB_POOL_SIZE=20

# Migrations are applied on boot so a deployment can never run against an
# outdated schema.
RUN_MIGRATIONS_ON_START=true
# Demo data must never be injected into production.
SEED_ON_START=false

SWAGGER_ENABLED=true
# Restrict this to the real front-end origin in a public deployment.
CORS_ORIGIN=*
LOG_LEVEL=warn

# --- Consumed by the PostgreSQL container only ---
POSTGRES_USER=inventory_prod
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PRODUCTION_PASSWORD
POSTGRES_DB=inventory_prod
