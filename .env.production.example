# PRODUCTION environment.  cp .env.production.example .env.production
#
# Shares nothing with test: different project, port, database and credentials.
# Use a real password here.
COMPOSE_PROJECT_NAME=inventory-prod
NODE_ENV=production
API_PORT=3200
DB_USER=inventory_prod
DB_PASSWORD=change_me_production
DB_PORT=5434
DB_NAME=inventory_prod
# Demo data must never reach production. The application refuses to seed when
# NODE_ENV=production even if this were true.
SEED=false
