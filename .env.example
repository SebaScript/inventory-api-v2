# cp .env.example .env
NODE_ENV=development
SEED=true

PORT=3000

# Compose's PostgreSQL. 5433: 5432 is usually taken by a local one.
DB_USER=inventory
DB_PASSWORD=inventory
DB_NAME=inventory
DB_PORT=5433
API_PORT=3000

# For `npm test` / `npm run start:dev`. No `sslmode`: it would override DB_SSL.
DATABASE_URL=postgres://inventory:inventory@localhost:5433/inventory

# Cloud settings, all off locally: empty means the feature is disabled.
DB_SSL=false
DB_SYNC=true
REDIS_URL=
S3_BUCKET=
AWS_REGION=


# The other cloud, through the orchestrator.
ORCHESTRATOR_URL=
PARTNER_KEY=
ORCHESTRATOR_API_KEY=
# Short: this call runs inside a GET.
INTEROP_TIMEOUT_MS=1500
