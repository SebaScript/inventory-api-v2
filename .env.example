# ---------------------------------------------------------------------------
# Local development environment (docker compose up --build)
#
# Copy to `.env` before running outside Docker:  cp .env.example .env
# Docker Compose already supplies these values, so `.env` is optional there.
#
# NEVER commit a real `.env` file. Only the *.example templates are tracked.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000

# Inside Docker the host is the compose service name (`postgres`).
# Running the API on the host instead? Use `localhost:5432`.
DATABASE_URL=postgres://inventory:inventory_dev_password@postgres:5432/inventory_dev

DB_SSL=false
DB_LOGGING=false
DB_POOL_SIZE=10

# The container entrypoint applies migrations and demo data on first boot.
RUN_MIGRATIONS_ON_START=true
SEED_ON_START=true

SWAGGER_ENABLED=true
CORS_ORIGIN=*
LOG_LEVEL=log

# --- Consumed by the PostgreSQL container only (docker-compose.yml) ---
POSTGRES_USER=inventory
POSTGRES_PASSWORD=inventory_dev_password
POSTGRES_DB=inventory_dev
