# cp .env.example .env
NODE_ENV=development
SEED=true

# Read by the application, whether it runs on the host or in a container.
PORT=3000

# Read by Compose to raise the PostgreSQL service. The host port is 5433
# because 5432 is usually taken by a locally installed PostgreSQL.
DB_USER=inventory
DB_PASSWORD=inventory
DB_NAME=inventory
DB_PORT=5433
API_PORT=3000

# Used when the application runs on the host — `npm test`, `npm run start:dev`.
# It has to match the DB_* values above. Inside Compose the API gets its own
# DATABASE_URL, pointing at the `postgres` service instead of localhost.
#
# Never add `sslmode` to this URL: node-postgres merges the connection string
# over the driver options, so it would silently override DB_SSL below.
DATABASE_URL=postgres://inventory:inventory@localhost:5433/inventory

# Cloud settings. Every one of them is off here on purpose: with the values
# empty the application behaves exactly as it always has, which is what keeps
# the test suite and `npm run docker:dev` working with nothing else installed.

# true against a managed database that refuses plaintext connections.
DB_SSL=false
# false once the schema exists, so replicas do not build it concurrently.
DB_SYNC=true
# Empty: the cache is disabled and every listing reads the database.
REDIS_URL=
# Empty: POST /v2/exports/items answers 503 EXPORT_UNAVAILABLE.
S3_BUCKET=
AWS_REGION=
