# cp .env.example .env
NODE_ENV=development
SEED=true

# Read by the application, whether it runs on the host or in a container.
PORT=3000

# Read by Compose to raise the PostgreSQL service. The host port is 5433
# because 5432 is usually taken by a locally installed PostgreSQL.
DB_USER=inventory
DB_PASSWORD=inventory
DB_NAME=inventory
DB_PORT=5433
API_PORT=3000

# Used when the application runs on the host — `npm test`, `npm run start:dev`.
# It has to match the DB_* values above. Inside Compose the API gets its own
# DATABASE_URL, pointing at the `postgres` service instead of localhost.
DATABASE_URL=postgres://inventory:inventory@localhost:5433/inventory
