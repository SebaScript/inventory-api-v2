# ---------------------------------------------------------------------------
# TEST environment  —  docker compose -f docker-compose.test.yml up --build
#
# Copy to `.env.test` before starting the stack:  cp .env.test.example .env.test
#
# This environment is fully independent from Production: different port,
# different PostgreSQL container, different volume, different credentials.
# It must NEVER point at the production database.
# ---------------------------------------------------------------------------

NODE_ENV=test
PORT=3000

# Exposed on the host at http://localhost:3100 (see docker-compose.test.yml).
DATABASE_URL=postgres://inventory_test:CHANGE_ME_TEST_PASSWORD@postgres-test:5432/inventory_test

DB_SSL=false
DB_LOGGING=false
DB_POOL_SIZE=10

RUN_MIGRATIONS_ON_START=true
# Demo data is wanted here: the Test environment doubles as the demo/QA target.
SEED_ON_START=true

SWAGGER_ENABLED=true
CORS_ORIGIN=*
LOG_LEVEL=log

# --- Consumed by the PostgreSQL container only ---
POSTGRES_USER=inventory_test
POSTGRES_PASSWORD=CHANGE_ME_TEST_PASSWORD
POSTGRES_DB=inventory_test
