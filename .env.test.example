# TEST environment.  cp .env.test.example .env.test
#
# Independent from production: its own compose project (so its own containers,
# network and volume), its own port, its own database and its own credentials.
COMPOSE_PROJECT_NAME=inventory-test
NODE_ENV=test
API_PORT=3100
DB_USER=inventory_test
DB_PASSWORD=change_me_test
DB_PORT=5433
DB_NAME=inventory_test
SEED=true

# The image the pipeline published for this environment. The deploy job pulls
# this tag, so nothing is ever built on the server.
API_IMAGE=ghcr.io/sebascript/inventory-api-v2:test
