    {
      "name": "5. Business rules (these are meant to fail)",
      "description": "Every request here returns an error on purpose. This is where the rules of the domain are visible.",
      "item": [
        {
          "name": "409 - insufficient stock",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/movements",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "movements"
              ]
            },
            "description": "THE CENTRAL RULE: stock can never go negative. The transaction rolls back, so no movement is written and the stock is untouched. The error carries available and requested so the client can react.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"itemId\": {{itemId}},\n  \"type\": \"OUT\",\n  \"quantity\": 999999\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 409\", () => pm.response.to.have.status(409));",
                  "const b = pm.response.json();",
                  "pm.test(\"code\", () => pm.expect(b.code).to.eql(\"INSUFFICIENT_STOCK\"));",
                  "pm.test(\"says what was available\", () => pm.expect(b.available).to.eql(120));"
                ]
              }
            }
          ]
        },
        {
          "name": "404 - movement on an unknown item",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/movements",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "movements"
              ]
            },
            "description": "The item does not exist.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"itemId\": 999999,\n  \"type\": \"IN\",\n  \"quantity\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 404\", () => pm.response.to.have.status(404));",
                  "pm.test(\"code\", () => pm.expect(pm.response.json().code).to.eql(\"ITEM_NOT_FOUND\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "409 - duplicate SKU",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/items",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "items"
              ]
            },
            "description": "SKUs are unique. The comparison is case-insensitive because the SKU is stored uppercase.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"groupId\": {{groupId}},\n  \"name\": \"Duplicate attempt\",\n  \"sku\": \"{{itemSku}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 409\", () => pm.response.to.have.status(409));",
                  "pm.test(\"code\", () => pm.expect(pm.response.json().code).to.eql(\"SKU_TAKEN\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "400 - validation failed",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/groups",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "groups"
              ]
            },
            "description": "The name is too short AND the body carries a field the DTO does not declare. Unknown fields are rejected rather than ignored, so a typo is a loud 400.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"A\",\n  \"unknownField\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"code\", () => pm.expect(pm.response.json().code).to.eql(\"VALIDATION_FAILED\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "400 - the client cannot set the stock",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/items/{{itemId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "items",
                "{{itemId}}"
              ]
            },
            "description": "Stock belongs to the ledger, so the field is not on the DTO at all. The only way to change it is a movement.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 999\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 400\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "409 - deleting a category that still has products",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/groups/{{groupId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "groups",
                "{{groupId}}"
              ]
            },
            "description": "Deleting a category must never destroy the inventory inside it. The API explains why instead of letting the database raise a raw foreign-key error."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 409\", () => pm.response.to.have.status(409));",
                  "pm.test(\"code\", () => pm.expect(pm.response.json().code).to.eql(\"GROUP_NOT_EMPTY\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "404 - unknown id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/items/999999",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "items",
                "999999"
              ]
            },
            "description": "Every route answers 404 the same way, with the same error shape."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 404\", () => pm.response.to.have.status(404));",
                  "pm.test(\"code\", () => pm.expect(pm.response.json().code).to.eql(\"ITEM_NOT_FOUND\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "6. Discontinue and reactivate",
      "description": "DELETE on a product means \"withdrawn from service\", not \"erased\". This is what keeps the history auditable.",
      "item": [
        {
          "name": "DELETE /items/:id - discontinues it",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/items/{{itemId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "items",
                "{{itemId}}"
              ]
            },
            "description": "Marks the product DISCONTINUED. Nothing is erased."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /items/:id - still there, marked",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/items/{{itemId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "items",
                "{{itemId}}"
              ]
            },
            "description": "The product is still readable, with its stock intact."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test(\"DISCONTINUED\", () => pm.expect(b.status).to.eql(\"DISCONTINUED\"));",
                  "pm.test(\"stock untouched\", () => pm.expect(b.quantity).to.eql(120));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /movements - the history survives",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/movements?itemId={{itemId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "movements"
              ],
              "query": [
                {
                  "key": "itemId",
                  "value": "{{itemId}}"
                }
              ]
            },
            "description": "The whole ledger is still there. This is the point of not deleting."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"still three entries\", () => pm.expect(pm.response.json().meta.total).to.eql(3));"
                ]
              }
            }
          ]
        },
        {
          "name": "409 - no movements on a discontinued product",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/movements",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "movements"
              ]
            },
            "description": "It can no longer be operated on.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"itemId\": {{itemId}},\n  \"type\": \"IN\",\n  \"quantity\": 5\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 409\", () => pm.response.to.have.status(409));",
                  "pm.test(\"code\", () => pm.expect(pm.response.json().code).to.eql(\"ITEM_DISCONTINUED\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "409 - its SKU stays reserved",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/items",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "items"
              ]
            },
            "description": "If another product reused it, the old movements would become ambiguous.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"groupId\": {{groupId}},\n  \"name\": \"Trying to reuse the SKU\",\n  \"sku\": \"{{itemSku}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 409\", () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        },
        {
          "name": "PATCH /items/:id - bring it back",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/items/{{itemId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "items",
                "{{itemId}}"
              ]
            },
            "description": "Reactivates the product. It accepts movements again.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"ACTIVE\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"ACTIVE again\", () => pm.expect(pm.response.json().status).to.eql(\"ACTIVE\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "DELETE /groups/:id - an empty category can be deleted",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/groups/{{spareGroupId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "groups",
                "{{spareGroupId}}"
              ]
            },
            "description": "Groups are deleted for real, but only when nothing depends on them."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "7. Documentation",
      "item": [
        {
          "name": "GET /docs-json - the OpenAPI document",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/docs-json",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "docs-json"
              ]
            },
            "description": "Generated from the code, so it cannot fall out of date. It cannot list QUERY: OpenAPI 3.0 has a closed list of methods that excludes it, which is why the POST alias exists."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"QUERY cannot be documented\", () => pm.expect(pm.response.json().paths[\"/items/search\"]).to.not.have.property(\"query\"));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
