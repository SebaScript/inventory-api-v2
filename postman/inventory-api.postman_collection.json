    {
      "name": "3. Items",
      "description": "An item is a product: the current state, that is, how much stock exists right now.",
      "item": [
        {
          "name": "POST /items - create with opening stock",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/items",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "items"
              ]
            },
            "description": "Creates a product. The optional opening stock is written as an IN movement, so even the first units have a ledger entry. The SKU is stored uppercase.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"groupId\": {{groupId}},\n  \"name\": \"Postman Cable\",\n  \"sku\": \"PM-{{$timestamp}}\",\n  \"quantity\": 100,\n  \"minimumStock\": 20,\n  \"unitPrice\": 12.5\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 201\", () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "pm.collectionVariables.set(\"itemId\", b.id);",
                  "pm.collectionVariables.set(\"itemSku\", b.sku);",
                  "pm.test(\"stock is the opening quantity\", () => pm.expect(b.quantity).to.eql(100));",
                  "pm.test(\"starts ACTIVE\", () => pm.expect(b.status).to.eql(\"ACTIVE\"));"
                ]
              }
            }
          ]
        },
