    {
      "name": "4. Movements",
      "description": "A movement is an entry or exit of stock: the immutable ledger. No PUT, PATCH or DELETE.",
      "item": [
        {
          "name": "POST /movements - IN",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/movements",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "movements"
              ]
            },
            "description": "Writes the ledger entry AND the new stock in one transaction, with the item row locked so concurrent requests cannot oversell.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"itemId\": {{itemId}},\n  \"type\": \"IN\",\n  \"quantity\": 50,\n  \"reason\": \"Supplier delivery\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"stock is 150\", () => pm.expect(pm.response.json().resultingStock).to.eql(150));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /movements - OUT",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
