  "item": [
    {
      "name": "1. Health",
      "description": "Liveness of the service and of its database.",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Runs a real query against PostgreSQL. Returns 503 if the database is unreachable. Docker uses this as the container HEALTHCHECK."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"database is up\", () => pm.expect(pm.response.json().database).to.eql(\"up\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
