        {
          "name": "PATCH /items/:id - update",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/items/{{itemId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "items",
                "{{itemId}}"
              ]
            },
            "description": "Updates only the fields that were sent. The stock is never one of them - it is owned by the ledger - and quantity is not even on the DTO.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Cable renamed\",\n  \"unitPrice\": 19.99\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test(\"price changed\", () => pm.expect(b.unitPrice).to.eql(19.99));",
                  "pm.test(\"stock untouched\", () => pm.expect(b.quantity).to.eql(100));",
                  "pm.test(\"minimumStock kept\", () => pm.expect(b.minimumStock).to.eql(20));"
                ]
              }
            }
          ]
        }
      ]
