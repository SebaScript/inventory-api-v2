        {
          "name": "QUERY /items/search - the QUERY verb",
          "request": {
            "method": "QUERY",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/items/search",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "items",
                "search"
              ]
            },
            "description": "THE HTTP QUERY VERB: safe and idempotent like GET, but it carries a request body.\n\nIt is used here because the filter holds a LIST of category ids plus a price range - something a query string cannot carry without inventing an encoding for arrays.\n\nIf your Postman build cannot send QUERY, use the POST alias below: same body, same response.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"postman\",\n  \"groupIds\": [\n    {{groupId}}\n  ],\n  \"minPrice\": 0,\n  \"maxPrice\": 1000,\n  \"page\": 1,\n  \"limit\": 20\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"paginated envelope\", () => pm.expect(pm.response.json()).to.have.all.keys(\"data\", \"meta\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /items/search - identical alias",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/items/search",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "items",
                "search"
              ]
            },
            "description": "Exists only because Swagger UI and some proxies cannot emit QUERY. The canonical verb is QUERY, and a test asserts both return exactly the same thing.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"postman\",\n  \"groupIds\": [\n    {{groupId}}\n  ],\n  \"minPrice\": 0,\n  \"maxPrice\": 1000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
